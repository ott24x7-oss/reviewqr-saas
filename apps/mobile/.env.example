# Public API origin. No trailing slash. This value is bundled into the app.
# Example: http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# In a development build, use a local Agent session and mock API data for UI review and tests.
EXPO_PUBLIC_AGENT_MOCK=0

# Leave empty until you create an EAS project. Not a secret, but it identifies the Expo project.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Digital plan sales stay off. Physical QR/NFC stands still check out through the server.
# Set to 1 only after you choose Play Billing or India user-choice billing.
EXPO_PUBLIC_SELL_PLANS=0
