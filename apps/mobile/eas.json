{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://qr24x7.in",
        "EXPO_PUBLIC_SELL_PLANS": "0",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "00c6693d-9ab5-4dce-9de6-e24889f469fa",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://qr24x7.in",
        "EXPO_PUBLIC_SELL_PLANS": "0",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "00c6693d-9ab5-4dce-9de6-e24889f469fa",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "admin-preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "admin",
        "EXPO_PUBLIC_APP_VARIANT": "admin",
        "EXPO_PUBLIC_API_URL": "https://qr24x7.in",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "00c6693d-9ab5-4dce-9de6-e24889f469fa",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "admin-production": {
      "autoIncrement": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "admin",
        "EXPO_PUBLIC_APP_VARIANT": "admin",
        "EXPO_PUBLIC_API_URL": "https://qr24x7.in",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "00c6693d-9ab5-4dce-9de6-e24889f469fa",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.qr24x7.app",
        "track": "internal"
      }
    }
  }
}
