// ReviewQR Prisma Schema
// Production-ready schema for Indian SMB review management SaaS

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================
// AUTH & USERS
// ==========================

enum UserRole {
  USER
  ADMIN
  AGENCY
  STAFF
  AGENT
}

enum PushPlatform {
  IOS
  ANDROID
}

enum SubscriptionTier {
  FREE
  STARTER
  GROWTH
  AGENCY
  FOUNDER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  password       String?
  name           String?
  phone          String?
  image          String?
  pushEnabled    Boolean   @default(true)
  // Set when the account is anonymized. The row stays so Payment records can.
  deletedAt      DateTime?
  role           UserRole  @default(USER)
  agencyId       String?
  agency         User?     @relation("AgencyClients", fields: [agencyId], references: [id], onDelete: SetNull)
  clients        User[]    @relation("AgencyClients")

  // White-label
  whiteLabelEnabled Boolean @default(false)
  whiteLabelLogo    String?
  whiteLabelName    String?
  whiteLabelDomain  String?
  whiteLabelColor   String?

  // Subscription
  subscriptionTier   SubscriptionTier   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  razorpayCustomerId String?
  stripeCustomerId   String?

  businesses      Business[]
  agentBusinesses Business[] @relation("BusinessAgent")
  sessions    Session[]
  accounts    Account[]
  payments    Payment[]
  apiKeys     ApiKey[]
  notifications Notification[]
  subscriptionReminders SubscriptionReminder[]
  memberships     BusinessMember[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[] @relation("SupportMessageAuthor")
  onboardingMarks OnboardingMark[]
  printBatches    PrintBatch[]
  refreshSessions RefreshSession[]
  pushDevices     PushDevice[]
  shippingAddresses ShippingAddress[]
  referralCodes   ReferralCode[]
  shopCart        ShopCart?
  shopOrders      ShopOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Mobile refresh tokens. Only the hash is stored. Rotation keeps the family id.
model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String
  tokenHash  String    @unique
  usedAt     DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime
  deviceName String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@index([familyId])
}

// Expo push tokens. This is not an NFC Device.
model PushDevice {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String       @unique
  platform   PushPlatform
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  @@index([userId])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Background work. Claim with FOR UPDATE SKIP LOCKED.
model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  runAt          DateTime  @default(now())
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastError      String?   @db.Text
  lockedBy       String?
  lockedUntil    DateTime?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finishedAt     DateTime?

  @@index([status, runAt])
}

model WorkerHeartbeat {
  id     String   @id
  seenAt DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================
// BUSINESSES & LOCATIONS
// ==========================

model Business {
  id              String  @id @default(cuid())
  ownerId         String
  owner           User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           User?   @relation("BusinessAgent", fields: [agentId], references: [id], onDelete: SetNull)
  name            String
  slug            String  @unique
  industry        String?
  description     String? @db.Text
  logo            String?
  coverImage      String?
  primaryColor    String  @default("#2563eb")
  email           String?
  phone           String?
  whatsappNumber  String?
  whatsappVerifiedAt DateTime?
  website         String?
  address         String? @db.Text
  city            String?
  state           String?
  pincode         String?

  // Review settings
  googleReviewUrl   String?  @db.Text
  googlePlaceId     String?
  trustpilotUrl     String?  @db.Text
  reviewPlatform    String   @default("google") // google | trustpilot — preferred public link order
  ratingThreshold   Int      @default(4) // used only when reviewGating is on
  reviewGating      Boolean  @default(false) // true hides the public link below ratingThreshold
  enableWhatsApp    Boolean  @default(true)
  enableEmail       Boolean  @default(true)
  customThankYou    String?  @db.Text
  whatsappTemplate  String?  @db.Text
  emailTemplate     String?  @db.Text

  // AI-assisted reviews (training context + opt-in)
  aiReviewsEnabled  Boolean  @default(false)
  services          String?  @db.Text // what the business offers — trains the AI

  // Custom domain (white-label)
  customDomain      String?  @unique
  customDomainVerified Boolean @default(false)

  isActive  Boolean @default(true)
  archived  Boolean @default(false)

  locations    Location[]
  staffMembers Staff[]
  reviews      Review[]
  feedbacks    Feedback[]
  qrCodes      QRCode[]
  campaigns    Campaign[]
  contacts     Contact[]
  tags         FeedbackTag[]
  reviewTemplates ReviewTemplate[]
  aiUsage      AiUsage[]
  members      BusinessMember[]
  invites      BusinessInvite[]
  tapPage      TapPage?
  menuCategories MenuCategory[]
  menuItems    MenuItem[]
  menuOrders   MenuOrder[]
  storeSettings StoreSettings?
  coupons      Coupon[]
  offerBanners OfferBanner[]
  devices      Device[]
  shopOrders   ShopOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([agentId])
  @@index([slug])
  @@index([customDomain])
}

model Location {
  id         String  @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  address    String? @db.Text
  city       String?
  state      String?
  pincode    String?
  phone      String?
  googleReviewUrl String? @db.Text
  isActive   Boolean @default(true)

  staffMembers Staff[]
  reviews      Review[]
  feedbacks    Feedback[]
  qrCodes      QRCode[]
  devices      Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
}

model Staff {
  id         String  @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name       String
  slug       String
  role       String?
  email      String?
  phone      String?
  photo      String?
  isActive   Boolean @default(true)

  reviews   Review[]
  feedbacks Feedback[]
  qrCodes   QRCode[]
  devices   Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([locationId])
}

// ==========================
// REVIEWS & FEEDBACK
// ==========================

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  IGNORED
}

// Review = the public-facing rating event (every customer who clicks the link)
model Review {
  id         String  @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  staffId    String?
  staff      Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  rating     Int          // 1..5
  sentiment  ReviewSentiment
  redirected Boolean  @default(false) // true if sent to Google
  source     String?  // qr / link / whatsapp / email / widget

  customerName  String?
  customerEmail String?
  customerPhone String?
  // Set only when the customer agreed to store contact details.
  consentAt  DateTime?

  ipAddress  String?
  userAgent  String? @db.Text
  fingerprint String?

  feedback   Feedback?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, rating])
  @@index([locationId])
  @@index([staffId])
  @@index([fingerprint])
}

model Feedback {
  id         String  @id @default(cuid())
  reviewId   String  @unique
  review     Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  staffId    String?
  staff      Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  message    String  @db.Text
  status     FeedbackStatus @default(NEW)
  internalNote String? @db.Text
  npsScore   Int? // 0-10

  tags       FeedbackTagOnFeedback[]

  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, createdAt])
  @@index([status])
  @@index([businessId, status])
}

model FeedbackTag {
  id         String  @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  color      String  @default("#3b82f6")

  feedbacks  FeedbackTagOnFeedback[]

  createdAt DateTime @default(now())

  @@unique([businessId, name])
}

model FeedbackTagOnFeedback {
  feedbackId String
  tagId      String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  tag        FeedbackTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([feedbackId, tagId])
}

// ==========================
// QR CODES & CAMPAIGNS
// ==========================

enum QRType {
  COUNTER
  TABLE
  BILL
  CARD
  POSTER
  CUSTOM
}

enum QrStatus {
  UNASSIGNED
  ACTIVE
  DISABLED
}

model QRCode {
  id         String  @id @default(cuid())
  // Null while the code is unassigned stock. Deleting a business detaches the
  // code instead of destroying a URL that may already be printed.
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  staffId    String?
  staff      Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  type       QRType  @default(COUNTER)
  label      String
  shortCode  String  @unique
  scans      Int     @default(0)
  // Kept in step with status so older queries keep working.
  isActive   Boolean @default(true)
  status     QrStatus @default(ACTIVE)
  assignedAt DateTime?

  qrScans    QrScan[]
  tapEvents  TapEvent[]
  menuOrders MenuOrder[]
  device     Device?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([status])
}

enum DeviceKind {
  CARD
  STANDEE
  STICKER
  KEYCHAIN
}

enum NfcChip {
  NTAG213
  NTAG215
  NTAG216
}

enum DeviceStatus {
  IN_STOCK
  ASSIGNED
  ACTIVE
  DISABLED
  LOST
}

model PrintBatch {
  id          String     @id @default(cuid())
  label       String
  templateId  String
  kind        DeviceKind
  count       Int
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  devices     Device[]
  createdAt   DateTime   @default(now())

  @@index([createdById])
}

model Device {
  id         String       @id @default(cuid())
  shortCode  String       @unique
  qr         QRCode       @relation(fields: [shortCode], references: [shortCode], onDelete: Cascade)
  kind       DeviceKind
  chipUid    String?      @unique
  chip       NfcChip?
  status     DeviceStatus @default(IN_STOCK)
  batchId    String?
  batch      PrintBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  businessId String?
  business   Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  staffId    String?
  staff      Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  tableLabel String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
  @@index([batchId])
  @@index([businessId])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id         String  @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  description String? @db.Text
  status     CampaignStatus @default(DRAFT)

  // Stats
  sent       Int @default(0)
  opened     Int @default(0)
  clicked    Int @default(0)
  reviewed   Int @default(0)

  whatsappTemplate String? @db.Text
  emailTemplate    String? @db.Text
  emailSubject     String?

  startedAt DateTime?
  endedAt   DateTime?

  reviews   Review[]
  contacts  CampaignContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model Contact {
  id         String  @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String?
  email      String?
  phone      String?
  notes      String? @db.Text
  /// Short labels such as VIP or regular. The owner writes these.
  tags       String[] @default([])
  source     String? // manual / csv / pos / api / order / feedback

  campaigns  CampaignContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, phone])
  @@index([businessId])
}

model CampaignContact {
  campaignId String
  contactId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  sentAt    DateTime?
  openedAt  DateTime?
  clickedAt DateTime?
  reviewedAt DateTime?

  @@id([campaignId, contactId])
}

// ==========================
// PAYMENTS & BILLING
// ==========================

enum PaymentStatus {
  PENDING
  QUEUED
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  MANUAL
  UPI
  USDT
  YOUPI
}

model Payment {
  id        String  @id @default(cuid())
  userId    String
  // Restrict so deleting a user cannot delete GST payment records.
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount    Int     // in paise
  currency  String  @default("INR")
  status    PaymentStatus @default(PENDING)
  provider  PaymentProvider @default(RAZORPAY)
  providerOrderId   String? @unique
  providerPaymentId String? @unique
  tier      SubscriptionTier
  periodMonths Int @default(1)
  invoiceUrl String?
  invoiceNumber String? @unique
  utr          String?
  refundUtr    String?
  queuePosition Int?
  checkoutUrl  String? @db.Text

  // Snapshot taken when the invoice number is issued. Later profile edits do not change it.
  invoiceBuyerName    String?
  invoiceBuyerGstin   String?
  invoiceSellerName   String?
  invoiceSellerGstin  String?
  invoicePlaceOfSupply String?
  invoiceTaxablePaise Int?
  invoiceCgstPaise    Int?
  invoiceSgstPaise    Int?
  invoiceIgstPaise    Int?
  invoiceIssuedAt     DateTime?

  // Manual UPI / USDT collection + email auto-verify
  method       String?   // "upi" | "usdt"
  reference    String?   // UTR (UPI) or transaction hash (USDT), entered by the customer
  network      String?   // e.g. TRC20 / BEP20 for USDT
  amountUsdt   Float?    // USDT amount when method = usdt
  verifiedVia  String?   // "email" | "manual" | "webhook"
  matchedEmail String?   // uid/subject of the confirmation email that matched
  expiresAt    DateTime? // pending order expiry

  deliveries PaymentDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
  @@index([provider, status])
}

// One row per Indian financial year. Locked with SELECT … FOR UPDATE while issuing invoice numbers.
model InvoiceSequence {
  fy         String @id
  lastNumber Int    @default(0)
}

model PaymentDelivery {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
}

model SubscriptionReminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  periodEnd DateTime
  createdAt DateTime @default(now())

  @@unique([userId, kind, periodEnd])
  @@index([userId])
}

// ==========================
// SYSTEM
// ==========================

model ApiKey {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  key       String  @unique
  lastUsed  DateTime?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum BusinessMemberRole {
  MANAGER
  STAFF
}

// Someone invited onto a business. The platform User.role is unchanged.
model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessMemberRole
  createdAt  DateTime           @default(now())

  @@unique([businessId, userId])
  @@index([userId])
}

model BusinessInvite {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  role       BusinessMemberRole
  tokenHash  String             @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime           @default(now())

  @@index([businessId, email])
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String           @default("OPEN")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String        @db.Text
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model Notification {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String  // negative_feedback, review_milestone, etc
  title     String
  message   String  @db.Text
  link      String?
  isRead    Boolean @default(false)
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// One counted visit per IP hash inside the dedupe window. ipHash is SHA-256, not reversible.
model QrScan {
  id         String   @id @default(cuid())
  qrCodeId   String
  qrCode     QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  ipHash     String
  deviceType String?
  // qr | nfc | link. Older rows stay null and are treated as qr.
  source     String?
  event      String   @default("view")
  createdAt  DateTime @default(now())

  @@index([qrCodeId, ipHash, createdAt])
}

// Views and button clicks. The deduped visit counter stays on QrScan.
model TapEvent {
  id         String   @id @default(cuid())
  businessId String?
  qrCodeId   String?
  qrCode     QRCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  type       String
  linkKey    String?
  source     String?
  deviceType String?
  ipHash     String
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([qrCodeId, createdAt])
}

model TapPage {
  id          String    @id @default(cuid())
  businessId  String    @unique
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  draft       Json      @default("{}")
  published   Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum VegMark {
  VEG
  NON_VEG
  EGG
  NONE
}

model MenuCategory {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  nameHi     String?
  sortOrder  Int        @default(0)
  items      MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([businessId])
}

model MenuItem {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String?
  category   MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  nameHi     String?
  pricePaise Int
  /// Optional crossed-out price shown next to the selling price.
  mrpPaise   Int?
  description String?
  bestseller Boolean       @default(false)
  photo      String?
  /// Extra gallery images. `photo` stays the cover. At most five, so six with the cover.
  photos     String[]      @default([])
  /// Shop brand. Empty on food and services.
  brand      String        @default("")
  /// Service length. Hidden on food and shop.
  durationMinutes Int?
  /// Shop barcode. Empty when the owner has not scanned or typed one.
  barcode    String        @default("")
  veg        VegMark       @default(NONE)
  available  Boolean       @default(true)
  sortOrder  Int           @default(0)
  variants   MenuVariant[]
  addOns     MenuAddOn[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([businessId, available])
  @@index([categoryId])
}

model MenuVariant {
  id         String   @id @default(cuid())
  itemId     String
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  businessId String
  label      String
  labelHi    String?
  /// Set together with colour for a shop size/colour pair. Food sizes use label only.
  size       String   @default("")
  colour     String   @default("")
  pricePaise Int
  inStock    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([itemId])
  @@index([businessId])
}

model MenuAddOn {
  id         String   @id @default(cuid())
  itemId     String
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  businessId String
  name       String
  nameHi     String?
  pricePaise Int      @default(0)
  inStock    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([itemId])
  @@index([businessId])
}

enum MenuOrderStatus {
  NEW
  ACCEPTED
  REJECTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
}

enum StoreLayout {
  AUTO
  FOOD
  SHOP
  SERVICES
}

enum StoreDesign {
  CLASSIC
  PREMIUM
  MINIMAL
  BOLD
}

model StoreSettings {
  id                     String      @id @default(cuid())
  businessId             String      @unique
  business               Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  layout                 StoreLayout @default(AUTO)
  /// Storefront look. Separate from the food, shop, or services layout.
  design                 StoreDesign @default(CLASSIC)
  hours                  Json?
  holiday                Boolean     @default(false)
  dineIn                 Boolean     @default(true)
  takeaway               Boolean     @default(true)
  delivery               Boolean     @default(false)
  deliveryPincodes       String      @default("")
  deliveryChargePaise    Int         @default(0)
  freeDeliveryAbovePaise Int?
  minOrderPaise          Int         @default(0)
  packingChargePaise     Int         @default(0)
  gstEnabled             Boolean     @default(false)
  gstPercent             Int         @default(5)
  pricesIncludeGst       Boolean     @default(true)
  prepMinutes            Int         @default(20)
  upiId                  String      @default("")
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model MenuOrder {
  id               String          @id @default(cuid())
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  qrCodeId         String?
  qrCode           QRCode?         @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  number           String          @unique
  customerName     String?
  customerPhone    String?
  /// Set only when the customer agreed to save their phone with this order.
  consentAt        DateTime?
  lang             String?
  tableOrAddress   String?
  note             String?         @db.Text
  orderType        String?
  pincode          String?
  subtotalPaise    Int             @default(0)
  discountPaise    Int             @default(0)
  deliveryPaise    Int             @default(0)
  packingPaise     Int             @default(0)
  gstPaise         Int             @default(0)
  pricesIncludeGst Boolean         @default(true)
  orderForLater    Boolean         @default(false)
  prepMinutes      Int?
  couponCode       String?
  payment          StorePayment?
  totalPaise       Int
  items            Json
  source           String?
  status           MenuOrderStatus @default(NEW)
  /// Status changes in order, each { status, at }.
  events           Json?
  createdAt        DateTime        @default(now())

  @@index([businessId, createdAt])
}

enum CouponKind {
  PERCENT
  FLAT
}

enum StorePayment {
  CASH
  UPI
}

model Coupon {
  id               String     @id @default(cuid())
  businessId       String
  business         Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code             String
  kind             CouponKind
  /// Percent from 1 to 100, or a flat discount in paise.
  amount           Int
  minSubtotalPaise Int        @default(0)
  expiresAt        DateTime?
  usageLimit       Int?
  usedCount        Int        @default(0)
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([businessId, code])
  @@index([businessId])
}

model OfferBanner {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  body       String   @default("")
  /// When set, the banner leaves the storefront after this moment.
  expiresAt  DateTime?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

model IndustryPreset {
  id        String   @id @default(cuid())
  industry  String   @unique
  links     Json
  updatedAt DateTime @updatedAt
}

model OnboardingMark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@unique([userId, kind])
  @@index([userId])
}

// Per-business AI calls for a calendar month (Asia/Kolkata), key YYYY-MM.
model AiUsage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  month      String
  calls      Int      @default(0)

  @@unique([businessId, month])
  @@index([businessId])
}

// Platform-wide estimated AI spend for one calendar day, key YYYY-MM-DD.
model PlatformAiSpend {
  day   String @id
  paise Int    @default(0)
}

// Login OTPs for email and phone. Password reset and email-verify links stay on VerificationToken.
// channel is "email" or "phone". Only the hash of the code is stored.
model EmailOtp {
  id         String   @id @default(cuid())
  identifier String
  tokenHash  String
  channel    String
  purpose    String
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier, purpose])
  @@index([tokenHash])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?  @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

// Per-business stock of pre-written positive reviews. After a happy
// customer copies one to paste on Google, the row flips to used=true so
// no two customers ever post the same text.
model ReviewTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  used       Boolean  @default(false)
  usedAt     DateTime?
  usedIp     String?
  createdAt  DateTime @default(now())

  @@index([businessId, used])
}

// Admin-editable key/value config (overrides env). value holds JSON.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ReviewQR's own hardware catalogue. This is not a business's WhatsApp store.
model CatalogProduct {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  nameHi            String?
  description       String           @db.Text
  descriptionHi     String?          @db.Text
  needsNfc          Boolean          @default(false)
  needsDesign       Boolean          @default(true)
  defaultTemplateId String?
  active            Boolean          @default(true)
  sortOrder         Int              @default(0)
  variants          CatalogVariant[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model CatalogVariant {
  id         String         @id @default(cuid())
  productId  String
  product    CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String         @unique
  name       String
  nameHi     String?
  costPaise  Int
  mrpPaise   Int
  salePaise  Int
  hsn        String
  gstPercent Int
  weightGrams Int
  lengthMm   Int
  widthMm    Int
  heightMm   Int
  stock      Int            @default(0)
  lowStockAt Int            @default(10)
  minQty     Int            @default(1)
  imageUrl   String?        @db.Text
  active     Boolean        @default(true)
  // Set together on a plan bundle. Lifetime is the Founder SKU only.
  includedTier     SubscriptionTier?
  includedMonths   Int?
  includedLifetime Boolean          @default(false)
  // Digital SKUs (the Founder plan) do not ship and may use a zero box.
  ships      Boolean        @default(true)
  cartLines  ShopCartLine[]
  orderLines ShopOrderLine[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([productId])
  @@index([active, stock])
}

// One open ReviewQR shop cart per owner. Not a business's WhatsApp menu cart.
model ShopCart {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId     String?
  couponCode     String?
  referralCode   String?
  buyerGstin     String?
  buyerLegalName String?
  addressId      String?
  lines          ShopCartLine[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ShopCartLine {
  id        String         @id @default(cuid())
  cartId    String
  cart      ShopCart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int
  design    Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

// Platform coupons for the ReviewQR shop. Not a business's store Coupon.
model ShopCoupon {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int?
  flatPaise  Int?
  active     Boolean   @default(true)
  expiresAt  DateTime?
  maxUses    Int?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ReferralCode {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  percentOff Int?
  flatPaise  Int?
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model ShippingAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// A ReviewQR shop order. Plan payments stay on Payment. This row is the hardware or bundle sale.
enum ShopOrderStatus {
  PENDING_PAYMENT
  PAID
  PROOF_SENT
  CHANGES_REQUESTED
  APPROVED
  PRINTING
  NFC_WRITTEN
  PACKED
  PICKUP_SCHEDULED
  SHIPPED
  DELIVERED
  CANCELLED
  RTO
  REPRINT
}

enum ShopPayStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model ShopOrder {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessId        String?
  business          Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  status            ShopOrderStatus @default(PENDING_PAYMENT)
  paymentStatus     ShopPayStatus   @default(PENDING)
  subtotalPaise     Int
  discountPaise     Int
  totalPaise        Int
  taxablePaise      Int
  cgstPaise         Int
  sgstPaise         Int
  igstPaise         Int
  advancePaise      Int
  balancePaise      Int
  cod               Boolean         @default(false)
  couponCode        String?
  referralCode      String?
  buyerGstin        String?
  buyerLegalName    String?
  buyerState        String?
  sellerName        String?
  sellerGstin       String?
  sellerState       String?
  addressJson       Json?
  providerPaymentId String?         @unique
  checkoutUrl       String?         @db.Text
  utr               String?
  verifiedVia       String?
  invoiceNumber     String?         @unique
  invoiceIssuedAt   DateTime?
  paidAt            DateTime?
  fingerprint       String?         @db.Text
  lines             ShopOrderLine[]
  deliveries        ShopPaymentDelivery[]
  shipment          ShopShipment?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([businessId])
}

model ShopOrderLine {
  id               String            @id @default(cuid())
  orderId          String
  order            ShopOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          CatalogVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku              String
  name             String
  qty              Int
  unitPaise        Int
  hsn              String
  gstPercent       Int
  discountPaise    Int
  netPaise         Int
  taxablePaise     Int
  cgstPaise        Int
  sgstPaise        Int
  igstPaise        Int
  ships            Boolean
  needsDesign      Boolean
  needsNfc         Boolean
  weightGrams      Int
  includedTier     SubscriptionTier?
  includedMonths   Int?
  includedLifetime Boolean           @default(false)
  design           Json?
  proofUrl         String?           @db.Text
  changeComment    String?           @db.Text
  createdAt        DateTime          @default(now())

  @@index([orderId])
  @@index([variantId])
}

// One gateway delivery may settle a shop order once. Plan deliveries stay on PaymentDelivery.
model ShopPaymentDelivery {
  id         String    @id @default(cuid())
  deliveryId String    @unique
  orderId    String
  order      ShopOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
}

// One carrier booking for a shop order. The label is stored here so a later job
// does not need the mock carrier's in-memory booking.
model ShopShipment {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  shipmentId  String?
  awb         String?
  courierName String?
  pickupId    String?
  labelName   String?
  labelBase64 String?   @db.Text
  ndrNote     String?   @db.Text
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([awb])
}

// One carrier webhook delivery. The key is event id + AWB + status.
model ShopCarrierEvent {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  awb       String
  status    String
  orderId   String?
  createdAt DateTime @default(now())

  @@index([awb])
}

// Singleton: admin-overridable branding for the WatShop Review *platform*
// marketing site (review.watshop.in). Per-tenant business branding lives on
// the Business model — do not conflate the two.
model PlatformBranding {
  id           String   @id @default("singleton")
  logoDataUrl  String   @default("")
  brandName    String   @default("")
  tagline      String   @default("")
  footerText   String   @default("")
  primaryColor String   @default("")
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id          String  @id @default(cuid())
  businessId  String
  authorName  String
  authorRole  String?
  authorImage String?
  rating      Int     @default(5)
  message     String  @db.Text
  isPublic    Boolean @default(false)
  isApproved  Boolean @default(false)
  source      String? // public_widget / manual / imported

  createdAt DateTime @default(now())

  @@index([businessId])
}
