# Database (PostgreSQL on Railway recommended)
DATABASE_URL="postgresql://user:password@host:5432/reviewqr?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Mobile access tokens (HS256). Required for /api/v1 login, refresh, and OTP verify.
# At least 16 characters. Generate with openssl rand -base64 32.
AUTH_TOKEN_SECRET=""
# Dev-only. When set outside production, POST /api/v1/auth/otp/request includes devCode.
# Ignored whenever NODE_ENV is production, even if this variable is set.
OTP_DEV_REVEAL=""
# Dev-only. When set outside production, shop checkout can confirm without YouPI.
# Ignored whenever NODE_ENV is production, even if this variable is set.
# A stubbed confirmation never issues an invoice number in production.
SHOP_PAYMENT_STUB=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="QR24x7"
# Hosts that still serve already-printed QR and NFC links. Comma-separated.
# Any other path on these hosts 301s to NEXT_PUBLIC_APP_URL.
LEGACY_HOSTS="review.watshop.in"

# Admin created once by `npm run seed:admin`. Required. No default password.
# A later seed does not change this password.
ADMIN_EMAIL="admin@reviewqr.in"
ADMIN_PASSWORD="replace-with-a-strong-password"

# AES-256-GCM key for agent PAN/bank details and secrets saved in app settings.
# Required in production. Generate with `openssl rand -base64 32` and keep it
# stable: losing or changing it makes encrypted values unreadable.
APP_ENCRYPTION_KEY=""

# SMTP (use Resend, SendGrid, Brevo, or Gmail App Password)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
SMTP_FROM="QR24x7 <noreply@qr24x7.in>"

# YouPI UPI gateway (default checkout). Razorpay stays off unless PAYMENTS_RAZORPAY_ENABLED=true.
YOUPI_BASE_URL=""
YOUPI_MERCHANT_ID=""
YOUPI_WEBHOOK_SECRET=""
CRON_SECRET=""
SELLER_GSTIN=""
# Optional carrier fallbacks. Admin → Shipping still chooses mock, Shiprocket, or Delhivery.
# A value saved in Admin wins. An empty saved value falls through to these.
# Mock in production is "Not configured" and does not call a carrier.
# Carrier webhooks: POST /api/shipping/webhook with header x-shipping-token or Authorization: Bearer.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
DELHIVERY_TOKEN=""
SHIPPING_WEBHOOK_SECRET=""
# Optional salt for QR scan IP hashes. Falls back to NEXTAUTH_SECRET.
QR_SCAN_SALT=""
# Optional AI spend guard, in paise. Defaults: 20000 (₹200/day) and 100 per call.
AI_DAILY_CAP_PAISE="20000"
AI_ESTIMATE_PAISE="100"
PAYMENTS_RAZORPAY_ENABLED="false"

# S3-compatible object storage (Cloudflare R2). Leave blank to keep data-URL uploads.
# S3_PUBLIC_BASE_URL must be the public https origin that serves the bucket.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_REGION="auto"

# Razorpay (disabled unless the flag above is true)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (international fallback)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# WhatsApp (optional, via Meta Cloud API or Twilio)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# Optional. Onboarding can search Google Places when this is set. Manual entry works without it.
GOOGLE_PLACES_API_KEY=""
# Optional. "Order your printed QR/NFC" opens WhatsApp to this number. Digits only, with country code.
SUPPORT_WHATSAPP=""

# Cloudflare Turnstile (recommended over reCAPTCHA for India)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Second Railway service. The web service stays on `npm run start`.
# Start the worker with `npm run worker`. tsx is a devDependency, so that service must install dev dependencies.
WORKER_ID=""
# Optional Expo access token. Push sends without it when Expo allows the project.
EXPO_ACCESS_TOKEN=""
# Optional. Errors from /api/v1 are posted to this Sentry DSN. Empty disables it.
SENTRY_DSN=""

# Rate limiting (Upstash Redis - optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
