# Database (PostgreSQL on Railway recommended)
DATABASE_URL="postgresql://user:password@host:5432/reviewqr?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ReviewQR"

# Default admin (created by seed)
ADMIN_EMAIL="admin@reviewqr.in"
ADMIN_PASSWORD="ChangeMe@123"

# SMTP (use Resend, SendGrid, Brevo, or Gmail App Password)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
SMTP_FROM="ReviewQR <noreply@reviewqr.in>"

# Razorpay (Indian payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (international fallback)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# WhatsApp (optional, via Meta Cloud API or Twilio)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# Cloudflare Turnstile (recommended over reCAPTCHA for India)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Rate limiting (Upstash Redis - optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
